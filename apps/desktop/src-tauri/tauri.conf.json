{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigitalBots",
  "version": "1.0.0",
  "identifier": "com.digitalbots.management",
  "build": {
    "frontendDist": "../../server/public"
  },
  "app": {
    "windows": [
      {
        "title": "DigitalBots Management",
        "width": 1480,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* tauri://localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "DigitalBots Management",
    "longDescription": "A private business workspace for client, subscription, payment and security operations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
